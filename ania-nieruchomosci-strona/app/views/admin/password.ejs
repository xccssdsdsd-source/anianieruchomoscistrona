<%- include('_head', { title: 'Zmiana hasła' }) %>
<header class="a-head"><div><p class="a-eyebrow">Bezpieczeństwo</p><h1>Zmiana hasła</h1></div></header>
<form method="post" action="/admin/haslo" class="a-card a-card--narrow">
  <% if (saved) { %><p class="a-alert a-alert--ok">Hasło zmienione.</p><% } %>
  <% if (error) { %><p class="a-alert a-alert--err"><%= error %></p><% } %>
  <label class="a-field"><span>Obecne hasło</span><input type="password" name="current" autocomplete="current-password" required></label>
  <label class="a-field"><span>Nowe hasło (min. 8 znaków)</span><input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
  <label class="a-field"><span>Powtórz nowe hasło</span><input type="password" name="confirm" autocomplete="new-password" minlength="8" required></label>
  <button class="a-btn a-btn--primary" type="submit">Zmień hasło</button>
  <p class="a-muted">Hasło jest zapisywane jako skrót (scrypt) w pliku <code>data/auth.json</code>. Jeśli je zgubisz — usuń ten plik, a panel wróci do hasła domyślnego.</p>
</form>
<%- include('_foot') %>
